# ReconEngine — Environment variables
# Copy to .env and edit before running Docker:
#   cp .env.example .env

# ── Scan behaviour ─────────────────────────────────────────────────────────────

# Scan profile: quick (ports only) or full (services + OS + vuln scripts)
RECONENGINE_PROFILE=full

# Comma-separated nmap port expression. Leave empty to use the built-in
# security-focused default set (~65 ports covering the most exposed services).
# Examples: "22,80,443,8080"  or  "1-1024"
RECONENGINE_PORTS=

# Network interface to scan on (wlan0, eth0, …). Leave empty to auto-detect.
RECONENGINE_IFACE=

# Target network CIDR override. Leave empty to auto-detect from interface.
# Example: 192.168.1.0/24
RECONENGINE_TARGET=

# ARP broadcast discovery timeout in seconds.
# Auto-scaled for large networks (/16 → 30s), but can be overridden here.
RECONENGINE_DISCOVERY_TIMEOUT=5

# Number of parallel scan threads (one per host).
RECONENGINE_MAX_WORKERS=8

# ── Output ─────────────────────────────────────────────────────────────────────

# Directory where PDF reports are written (relative to the working directory).
RECONENGINE_OUTPUT_DIR=rapports

# Host directory to map into the container for report persistence.
# Only used by docker compose; maps to /app/rapports inside the container.
REPORT_OUTPUT_DIR=./rapports

# ── API server ─────────────────────────────────────────────────────────────────

# API key for the HTTP server (X-API-Key header).
# CHANGE THIS before exposing the API on a non-loopback interface!
RECONENGINE_API_KEY=changeme

# ── CVE enrichment ─────────────────────────────────────────────────────────────

# NVD (NIST) API key — optional but strongly recommended.
# Without key: 5 requests / 30 seconds (slow on large scans).
# With key:   50 requests / 30 seconds.
# Get a free key at: https://nvd.nist.gov/developers/request-an-api-key
# SECURITY: Never commit a real API key here. Use a placeholder only.
# Get a free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nvd-api-key-here

# ── Optional overrides ─────────────────────────────────────────────────────────

# Path to nmap binary (default: auto-resolved via PATH).
# NMAP_PATH=/usr/bin/nmap

# Path to a TOML config file (overridden by env vars above).
# RECONENGINE_CONFIG=/etc/reconengine.toml

# ── Embedded hardware — status LEDs (Orange Pi Zero 3 PCB) ─────────────────────
# Drives 2× WS2812B (LED1/LED2) + 2× discrete LEDs (LED3/LED4) on the audit PCB.
# Driver auto-disables gracefully if gpiod/spidev or the devices aren't present
# (dev machines, containers without /dev access). To use the LEDs:
#   pip install reconengine[hardware]   # pulls gpiod + spidev
#
# Set RECONENGINE_LED_ENABLED=0 to force-disable even when hardware is available.
# RECONENGINE_LED_ENABLED=1

# libgpiod chip device for discrete LEDs (LED3/LED4).
# RECONENGINE_LED_GPIOCHIP=/dev/gpiochip0

# libgpiod line offsets for the discrete LEDs (yellow = LED3, green = LED4).
# Adjust to match the GPIO pins actually routed on your PCB revision.
# RECONENGINE_LED_YELLOW_GPIO=71
# RECONENGINE_LED_GREEN_GPIO=76

# SPI device feeding the WS2812B data line. Bus 1 / device 0 is the second
# SPI controller on the H618 — adjust if you wired DIN to SPI0 instead.
# RECONENGINE_WS2812_SPI=/dev/spidev1.0
